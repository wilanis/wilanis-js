{
  "$schema": "https://raw.githubusercontent.com/wilanis/wilanis-js/main/packages/core/schemas/feature.schema.json",
  "label": "Monitor",
  "description": "Entries of the monitor: list them, read one, record one, update one, remove one, a digest, and a CSV import and export. Reads are public; every write is for a signed-in employee holding the recorder role.",
  "exports": [
    "@features/monitor/domain/monitor.port.json",
    "@features/monitor/domain/Entry.shape.json"
  ],
  "effects": [
    "@http/http.port.json#request",
    "@blob/csv.port.json#parse",
    "@blob/csv.port.json#write",
    "@storage/store.port.json#find",
    "@storage/store.port.json#get",
    "@storage/store.port.json#put",
    "@storage/store.port.json#patch",
    "@storage/store.port.json#remove",
    "@storage/store.port.json#newKey",
    "@storage/storage.port.json#ensure"
  ],
  "dependsOn": [
    "access"
  ]
}
