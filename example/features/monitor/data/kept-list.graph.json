{
  "$schema": "https://raw.githubusercontent.com/wilanis/wilanis-js/main/packages/core/schemas/graph.schema.json",
  "label": "List what is kept",
  "description": "Data graph behind monitor.listAll under the local profile: every record of the entries collection. A find with no filter answers the whole collection, which is what a small one is for.",
  "out": {
    "type": "@monitor/domain/Entry.shape.json[]",
    "from": [
      "rows"
    ]
  },
  "nodes": [
    {
      "type": "@wilanis/node/run.schema.json",
      "id": "rows",
      "label": "Read every entry",
      "run": "@storage/store.port.json#find",
      "in": {
        "store": "@monitor/data/entries.store.json",
        "collection": "entries",
        "order": [
          {
            "by": "url"
          }
        ]
      }
    }
  ]
}
