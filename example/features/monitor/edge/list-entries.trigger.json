{
  "$schema": "https://raw.githubusercontent.com/wilanis/wilanis-js/main/packages/core/schemas/trigger.schema.json",
  "label": "GET /monitor",
  "description": "GET /monitor[?method=] \u2192 the entries; 502 as upstream when the monitor API broke.",
  "kind": "@http/http.trigger-kind.json",
  "settings": {
    "route": "/monitor",
    "method": "GET",
    "produces": "application/json",
    "response": {
      "refusals": {
        "upstream": 502,
        "invariant": 500
      }
    }
  },
  "in": "@monitor/edge/ListRequest.shape.json",
  "out": "@monitor/edge/EntryView.shape.json[]",
  "fire": {
    "run": "@monitor/domain/monitor.port.json#list",
    "in": {
      "method": "{{request.query.method}}"
    }
  }
}
