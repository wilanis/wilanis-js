{
  "$schema": "https://raw.githubusercontent.com/wilanis/wilanis-js/main/packages/core/schemas/shape.schema.json",
  "label": "Entry (client view)",
  "layer": "edge",
  "description": "An entry as a client sees it. The trigger prunes anything the domain carries beyond these fields.",
  "fields": {
    "id": {
      "type": "string"
    },
    "url": {
      "type": "string"
    },
    "method": {
      "type": "string"
    },
    "agent": {
      "type": "string",
      "required": false
    }
  }
}
