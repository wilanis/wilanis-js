{
  "$schema": "https://raw.githubusercontent.com/wilanis/wilanis-js/main/packages/core/schemas/trigger.schema.json",
  "label": "POST /monitor",
  "description": "POST /monitor \u2192 201 with the recorded entry. The body is the input. 409 as conflict when an entry already records the call (the store declares (url, method) unique). 502 as upstream when the monitor API broke. Employees holding the recorder role only: 401 as anonymous without a token or as invalid_credential with a bad one, 403 as forbidden for a customer or an employee without the role.",
  "settings": {
    "route": "/monitor",
    "method": "POST",
    "consumes": "application/json",
    "produces": "application/json",
    "response": {
      "status": {
        "default": 201
      },
      "refusals": {
        "upstream": 502,
        "conflict": 409,
        "anonymous": 401,
        "invalid_credential": 401,
        "forbidden": 403,
        "invariant": 500
      }
    },
    "body": "@monitor/edge/RecordRequest.shape.json"
  },
  "in": "@monitor/edge/RecordRequest.shape.json",
  "out": "@monitor/edge/EntryView.shape.json",
  "policies": [
    {
      "policy": "@access/edge/employees-only.policy.json",
      "in": {
        "token": [
          "{{request.headers.authorization}}",
          "{{request.cookies.session}}"
        ]
      }
    },
    "@access/edge/can-record.policy.json"
  ],
  "kind": "@http/http.trigger-kind.json",
  "fire": {
    "run": "@monitor/domain/monitor.port.json#submit",
    "in": {
      "url": "{{request.body.url}}",
      "method": "{{request.body.method}}"
    }
  }
}
