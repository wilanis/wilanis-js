{
  "$schema": "https://raw.githubusercontent.com/wilanis/wilanis-js/main/packages/core/schemas/shape.schema.json",
  "label": "Entry record",
  "layer": "core",
  "description": "What monitor.record takes: a draft plus the recorder the domain chose.",
  "fields": {
    "url": {
      "type": "string"
    },
    "method": {
      "type": "string",
      "enum": [
        "GET",
        "POST",
        "PUT",
        "PATCH",
        "DELETE"
      ]
    },
    "agent": {
      "type": "string"
    }
  }
}
