{
  "$schema": "https://raw.githubusercontent.com/wilanis/wilanis-js/main/packages/core/schemas/trigger.schema.json",
  "label": "PUT /customers/{id}",
  "description": "PUT /customers/{id}: the id from the route, the new call from the body → the customer; 404 as missing when there is none, 502 as upstream when the monitor API broke. Employees holding the registrar role only: 401 as anonymous without a token or as invalid_credential with a bad one, 403 as forbidden for a customer or an employee without the role.",
  "settings": {
    "route": "/customers/{id}",
    "method": "PUT",
    "consumes": "application/json",
    "produces": "application/json",
    "body": "@customers/edge/UpdateRequest.shape.json",
    "response": {
      "refusals": {
        "missing": 404,
        "upstream": 502,
        "anonymous": 401,
        "invalid_credential": 401,
        "forbidden": 403,
        "invariant": 500
      }
    }
  },
  "in": "@customers/edge/UpdateRequest.shape.json",
  "out": "@customers/edge/CustomerView.shape.json",
  "policies": [
    {
      "policy": "@access/edge/employees-only.policy.json",
      "in": {
        "token": [
          "{{request.headers.authorization}}",
          "{{request.cookies.session}}"
        ]
      }
    },
    "@access/edge/can-register.policy.json"
  ],
  "kind": "@http/http.trigger-kind.json",
  "fire": {
    "run": "@customers/domain/customer.port.json#update",
    "in": {
      "id": "{{request.params.id}}",
      "name": "{{request.body.name}}",
      "email": "{{request.body.email}}",
      "tier": "{{request.body.tier}}"
    }
  }
}
