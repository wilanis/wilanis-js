{
  "$schema": "https://raw.githubusercontent.com/wilanis/wilanis-js/main/packages/core/schemas/trigger.schema.json",
  "label": "GET /customers",
  "description": "GET /customers[?tier=] → the customers; 502 as upstream when the customer API broke. For a signed-in caller only, who is answered their tenant's customers.",
  "kind": "@http/http.trigger-kind.json",
  "settings": {
    "route": "/customers",
    "method": "GET",
    "produces": "application/json",
    "response": {
      "refusals": {
        "upstream": 502,
        "invariant": 500,
        "anonymous": 401,
        "invalid_credential": 401
      }
    }
  },
  "in": "@customers/edge/ListRequest.shape.json",
  "out": "@customers/edge/CustomerView.shape.json[]",
  "policies": [
    {
      "policy": "@access/edge/signed-in.policy.json",
      "in": {
        "token": [
          "{{request.headers.authorization}}",
          "{{request.cookies.session}}"
        ]
      }
    }
  ],
  "fire": {
    "run": "@customers/domain/customer.port.json#list",
    "in": {
      "tier": "{{request.query.tier}}"
    }
  }
}
