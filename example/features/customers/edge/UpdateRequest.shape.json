{
  "$schema": "https://raw.githubusercontent.com/wilanis/wilanis-js/main/packages/core/schemas/shape.schema.json",
  "label": "Update request",
  "layer": "edge",
  "description": "PUT /customers/{id}: the id from the route, who the customer now is from the body.",
  "fields": {
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "tier": {
      "type": "string",
      "enum": ["bronze", "silver", "gold"]
    }
  }
}
