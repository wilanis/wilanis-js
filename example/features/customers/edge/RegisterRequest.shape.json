{
  "$schema": "https://raw.githubusercontent.com/wilanis/wilanis-js/main/packages/core/schemas/shape.schema.json",
  "label": "Register request",
  "layer": "edge",
  "description": "POST /customers body. Closed: an undeclared field is a 400, never a silent pass-through.",
  "fields": {
    "name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "tier": {
      "type": "string",
      "enum": ["bronze", "silver", "gold"]
    }
  }
}
