{
  "$schema": "https://raw.githubusercontent.com/wilanis/wilanis-js/main/packages/core/schemas/shape.schema.json",
  "label": "Customer record",
  "layer": "core",
  "description": "What customer.register takes: a draft plus the registrar the domain chose.",
  "fields": {
    "name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "tier": {
      "type": "string",
      "enum": ["bronze", "silver", "gold"]
    },
    "registrar": {
      "type": "string"
    }
  }
}
