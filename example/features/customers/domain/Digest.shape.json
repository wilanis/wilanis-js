{
  "$schema": "https://raw.githubusercontent.com/wilanis/wilanis-js/main/packages/core/schemas/shape.schema.json",
  "label": "Digest",
  "layer": "core",
  "description": "What the digest answers: how many customers there are, and one line per customer as text.",
  "fields": {
    "count": {
      "type": "number",
      "description": "how many customers"
    },
    "text": {
      "type": "string",
      "description": "one line per customer"
    }
  }
}
