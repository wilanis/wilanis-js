{
  "$schema": "https://raw.githubusercontent.com/wilanis/wilanis-js/main/packages/core/schemas/graph.schema.json",
  "label": "Digest",
  "description": "Every customer of every tenant counted and listed, composed into one Digest: the count from one node, the active ones kept and counted by another, the customers per tier totalled by a third, the text from a fourth.",
  "out": {
    "type": "@customers/domain/Digest.shape.json",
    "from": "digest"
  },
  "nodes": [
    {
      "type": "@wilanis/node/run.schema.json",
      "id": "all",
      "label": "Every customer, every tenant",
      "run": "@customers/domain/customer.port.json#listEvery"
    },
    {
      "type": "@wilanis/node/map.schema.json",
      "id": "lines",
      "label": "One line per customer",
      "run": "@std/text.port.json#fill",
      "over": "{{all}}",
      "bind": {
        "values": ""
      },
      "in": {
        "template": "- {name} <{email}> {tier}"
      }
    },
    {
      "type": "@wilanis/node/run.schema.json",
      "id": "joined",
      "label": "The lines as text",
      "run": "@std/text.port.json#join",
      "in": {
        "parts": "{{lines}}",
        "separator": "\n"
      }
    },
    {
      "type": "@wilanis/node/run.schema.json",
      "id": "count",
      "label": "How many",
      "run": "@std/list.port.json#count",
      "in": {
        "list": "{{all}}"
      }
    },
    {
      "type": "@wilanis/node/map.schema.json",
      "id": "active",
      "label": "The active customers",
      "over": "{{all}}",
      "where": "has(item.active) && item.active == true"
    },
    {
      "type": "@wilanis/node/run.schema.json",
      "id": "activeCount",
      "label": "How many are active",
      "run": "@std/list.port.json#count",
      "in": {
        "list": "{{active}}"
      }
    },
    {
      "type": "@wilanis/node/run.schema.json",
      "id": "tiers",
      "label": "Customers per tier",
      "run": "@std/list.port.json#totals",
      "in": {
        "list": "{{all}}",
        "type": "@customers/domain/Customer.shape.json",
        "by": "tier"
      }
    },
    {
      "type": "@wilanis/node/run.schema.json",
      "id": "digest",
      "label": "The digest",
      "run": "@std/object.port.json#make",
      "in": {
        "value": {
          "count": "{{count}}",
          "active": "{{activeCount}}",
          "tiers": "{{tiers}}",
          "text": "{{joined}}"
        },
        "type": "@customers/domain/Digest.shape.json"
      }
    }
  ]
}
