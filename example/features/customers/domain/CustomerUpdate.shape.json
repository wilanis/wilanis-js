{
  "$schema": "https://raw.githubusercontent.com/wilanis/wilanis-js/main/packages/core/schemas/shape.schema.json",
  "label": "Customer update",
  "layer": "core",
  "description": "A replacement for one customer: their id and who they now are.",
  "fields": {
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "tier": {
      "type": "string",
      "enum": ["bronze", "silver", "gold"]
    }
  }
}
