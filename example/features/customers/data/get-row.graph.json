{
  "$schema": "https://raw.githubusercontent.com/wilanis/wilanis-js/main/packages/core/schemas/graph.schema.json",
  "label": "Get a row",
  "description": "Data graph behind customer.get: GET the row. 200 is the customer, 404 is the declared refusal for an id that does not exist, anything else the API says is upstream, and so is the API saying nothing at all.",
  "in": "@customers/domain/CustomerRef.shape.json",
  "out": {
    "type": "@customers/domain/Customer.shape.json",
    "from": [
      "customer",
      "noCustomer",
      "upstreamFailed",
      "unreachable"
    ]
  },
  "nodes": [
    {
      "type": "@wilanis/node/run.schema.json",
      "id": "fetched",
      "label": "GET the row",
      "run": "@http/http.port.json#request",
      "timeoutMs": 5000,
      "retry": {
        "times": 2,
        "backoffMs": 200,
        "when": "status >= 500"
      },
      "in": {
        "connection": "@connections/customers-api.connection.json",
        "method": "GET",
        "path": "/customer/{{in.id}}",
        "produces": "application/json",
        "returns": "@customers/edge/CustomerRow.shape.json"
      }
    },
    {
      "type": "@wilanis/node/switch.schema.json",
      "id": "outcome",
      "label": "What did the API say?",
      "in": {
        "status": "{{fetched.status}}",
        "body": "{{fetched.body}}"
      },
      "rules": [
        {
          "when": "status == 404",
          "to": "noCustomer"
        },
        {
          "when": "status == 200 && has(body)",
          "to": "customer"
        }
      ],
      "else": "upstreamFailed",
      "catch": {
        "fetched": "unreachable"
      }
    },
    {
      "type": "@wilanis/node/run.schema.json",
      "id": "customer",
      "label": "The row",
      "run": "@std/object.port.json#make",
      "in": {
        "value": "{{fetched.body}}",
        "type": "@customers/edge/CustomerRow.shape.json"
      }
    },
    {
      "type": "@wilanis/node/run.schema.json",
      "id": "noCustomer",
      "label": "No such customer",
      "run": "@std/outcome.port.json#refuse",
      "in": {
        "reason": "missing",
        "message": "no customer {{in.id}}",
        "type": "@customers/domain/Customer.shape.json"
      }
    },
    {
      "type": "@wilanis/node/run.schema.json",
      "id": "upstreamFailed",
      "label": "Unexpected answer",
      "run": "@std/outcome.port.json#refuse",
      "in": {
        "reason": "upstream",
        "message": "the customer API answered {{fetched.status}}",
        "type": "@customers/domain/Customer.shape.json"
      }
    },
    {
      "type": "@wilanis/node/run.schema.json",
      "id": "unreachable",
      "label": "No answer",
      "run": "@std/outcome.port.json#refuse",
      "in": {
        "reason": "upstream",
        "message": "the customer API could not be reached",
        "type": "@customers/domain/Customer.shape.json"
      }
    }
  ]
}
