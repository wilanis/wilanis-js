{
  "$schema": "https://raw.githubusercontent.com/wilanis/wilanis-js/main/packages/core/schemas/graph.schema.json",
  "label": "Update what is kept",
  "description": "Data graph behind customer.update under the local profile: change the fields the caller gave and leave the rest. A patch never touches the key, and a key nothing is kept under is answered as absent.",
  "in": "@customers/domain/CustomerUpdate.shape.json",
  "out": {
    "type": "@customers/domain/Customer.shape.json",
    "from": [
      "customer",
      "noCustomer"
    ]
  },
  "nodes": [
    {
      "type": "@wilanis/node/run.schema.json",
      "id": "patched",
      "label": "Change the record",
      "run": "@storage/store.port.json#patch",
      "in": {
        "store": "@customers/data/customers.store.json",
        "collection": "customers",
        "key": "{{in.id}}",
        "changes": {
          "name": "{{in.name}}",
          "email": "{{in.email}}",
          "tier": "{{in.tier}}"
        }
      }
    },
    {
      "type": "@wilanis/node/switch.schema.json",
      "id": "wasThere",
      "label": "Was it there?",
      "in": {
        "record": "{{patched.record}}"
      },
      "rules": [
        {
          "when": "has(record)",
          "to": "customer"
        }
      ],
      "else": "noCustomer"
    },
    {
      "type": "@wilanis/node/run.schema.json",
      "id": "customer",
      "label": "The record",
      "run": "@std/object.port.json#make",
      "in": {
        "value": "{{patched.record}}",
        "type": "@customers/domain/Customer.shape.json"
      }
    },
    {
      "type": "@wilanis/node/run.schema.json",
      "id": "noCustomer",
      "label": "No such customer",
      "run": "@std/outcome.port.json#refuse",
      "in": {
        "reason": "missing",
        "message": "no customer {{in.id}}",
        "type": "@customers/domain/Customer.shape.json"
      }
    }
  ]
}
