{
  "$schema": "https://raw.githubusercontent.com/wilanis/wilanis-js/main/packages/core/schemas/graph.schema.json",
  "label": "List what is kept",
  "description": "Data graph behind customer.listAll under the local profile: every record of the customers collection. A find with no filter answers the whole collection, which is what a small one is for.",
  "out": {
    "type": "@customers/domain/Customer.shape.json[]",
    "from": [
      "customers"
    ]
  },
  "nodes": [
    {
      "type": "@wilanis/node/run.schema.json",
      "id": "customers",
      "label": "Read every customer",
      "run": "@storage/store.port.json#find",
      "in": {
        "store": "@customers/data/customers.store.json",
        "collection": "customers",
        "order": [
          {
            "by": "email"
          }
        ]
      }
    }
  ]
}
