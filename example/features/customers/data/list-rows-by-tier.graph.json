{
  "$schema": "https://raw.githubusercontent.com/wilanis/wilanis-js/main/packages/core/schemas/graph.schema.json",
  "label": "List rows by method",
  "description": "Data graph behind customer.listByTier: one GET narrowed by the tier, the rows when it answered 200. This API answers 404 to a filter that matches nothing rather than an empty list, so that is read as 'none of them', not as a fault: a tier no customer holds is an empty listing, and only an unexpected status refuses.",
  "in": "@customers/domain/Tier.shape.json",
  "out": {
    "type": "@customers/domain/Customer.shape.json[]",
    "from": [
      "customers",
      "none",
      "upstreamFailed"
    ]
  },
  "nodes": [
    {
      "type": "@wilanis/node/run.schema.json",
      "id": "requested",
      "label": "GET the rows of one method",
      "run": "@http/http.port.json#request",
      "in": {
        "connection": "@connections/customers-api.connection.json",
        "method": "GET",
        "path": "/customer?tier={{in.tier}}",
        "produces": "application/json",
        "returns": "@customers/edge/CustomerRow.shape.json[]"
      }
    },
    {
      "type": "@wilanis/node/switch.schema.json",
      "id": "outcome",
      "label": "What did the API say?",
      "in": {
        "status": "{{requested.status}}",
        "body": "{{requested.body}}"
      },
      "rules": [
        {
          "when": "status == 200 && has(body)",
          "to": "customers"
        },
        {
          "when": "status == 404",
          "to": "none"
        }
      ],
      "else": "upstreamFailed"
    },
    {
      "type": "@wilanis/node/run.schema.json",
      "id": "customers",
      "label": "The rows",
      "run": "@std/object.port.json#make",
      "in": {
        "value": "{{requested.body}}",
        "type": "@customers/edge/CustomerRow.shape.json[]"
      }
    },
    {
      "type": "@wilanis/node/run.schema.json",
      "id": "none",
      "label": "No customer holds that tier",
      "description": "This API says 404 where it means an empty collection; the domain says an empty listing.",
      "run": "@std/list.port.json#slice",
      "in": {
        "list": "{{const.nothing}}",
        "from": 0,
        "to": 0,
        "type": "@customers/domain/Customer.shape.json[]"
      }
    },
    {
      "type": "@wilanis/node/run.schema.json",
      "id": "upstreamFailed",
      "label": "Unexpected answer",
      "run": "@std/outcome.port.json#refuse",
      "in": {
        "reason": "upstream",
        "message": "the customer API answered {{requested.status}}",
        "type": "@customers/domain/Customer.shape.json[]"
      }
    }
  ],
  "constants": {
    "nothing": {
      "type": "@customers/domain/Customer.shape.json[]",
      "value": [],
      "description": "the empty listing a tier nobody holds answers"
    }
  }
}
