{
  "$schema": "https://raw.githubusercontent.com/wilanis/wilanis-js/main/packages/core/schemas/graph.schema.json",
  "label": "Create a row",
  "description": "Data graph behind customer.register: POST the record, take the row the API answers with 201. The caller's own user agent is forwarded to the API as a header; the row itself is attributed to the registrar the domain chose.",
  "reads": {
    "agent": "@customers/edge/request.resolvers.json#agent"
  },
  "in": "@customers/domain/CustomerRecord.shape.json",
  "out": {
    "type": "@customers/domain/Customer.shape.json",
    "from": [
      "row",
      "failed"
    ]
  },
  "nodes": [
    {
      "type": "@wilanis/node/run.schema.json",
      "id": "asked",
      "label": "POST the record",
      "run": "@http/http.port.json#request",
      "in": {
        "body": "{{in}}",
        "connection": "@connections/customers-api.connection.json",
        "method": "POST",
        "path": "/customers",
        "headers": {
          "x-forwarded-user-agent": "{{agent}}"
        },
        "consumes": "application/json",
        "produces": "application/json",
        "returns": "@customers/edge/CustomerRow.shape.json"
      }
    },
    {
      "type": "@wilanis/node/switch.schema.json",
      "id": "route",
      "label": "What did the API say?",
      "in": {
        "status": "{{asked.status}}",
        "body": "{{asked.body}}"
      },
      "rules": [
        {
          "when": "status == 201 && has(body)",
          "to": "row"
        }
      ],
      "else": "failed"
    },
    {
      "type": "@wilanis/node/run.schema.json",
      "id": "row",
      "label": "The created row",
      "run": "@std/object.port.json#make",
      "in": {
        "value": "{{asked.body}}",
        "type": "@customers/edge/CustomerRow.shape.json"
      }
    },
    {
      "type": "@wilanis/node/run.schema.json",
      "id": "failed",
      "label": "Unexpected answer",
      "run": "@std/outcome.port.json#refuse",
      "in": {
        "reason": "upstream",
        "message": "the customer API answered {{asked.status}}",
        "type": "@customers/domain/Customer.shape.json"
      }
    }
  ]
}
