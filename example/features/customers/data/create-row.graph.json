{
  "$schema": "https://raw.githubusercontent.com/wilanis/wilanis-js/main/packages/core/schemas/graph.schema.json",
  "label": "Create a row",
  "description": "Data graph behind customer.register over the REST API: POST the customer, take the row the API answers with 201. The customer arrives made whole in the domain, as register takes them; the API names a row's key itself, so the record sent is the customer narrowed to the fields CustomerRecord names -- who they are and who registered them -- and the row answered carries the key the API gave. The caller's own user agent is forwarded to the API as a header.",
  "reads": {
    "agent": "@customers/edge/request.resolvers.json#agent"
  },
  "in": "@customers/domain/Customer.shape.json",
  "out": {
    "type": "@customers/domain/Customer.shape.json",
    "from": [
      "customer",
      "upstreamFailed"
    ]
  },
  "nodes": [
    {
      "type": "@wilanis/node/run.schema.json",
      "id": "posted",
      "label": "POST the customer",
      "run": "@http/http.port.json#request",
      "in": {
        "body": "{{record}}",
        "connection": "@connections/customers-api.connection.json",
        "method": "POST",
        "path": "/customer",
        "headers": {
          "x-forwarded-user-agent": "{{agent}}"
        },
        "consumes": "application/json",
        "produces": "application/json",
        "returns": "@customers/edge/CustomerRow.shape.json"
      }
    },
    {
      "type": "@wilanis/node/run.schema.json",
      "id": "record",
      "label": "The record to send",
      "description": "the customer narrowed to a CustomerRecord: make keeps only the fields it declares, so the key nextId gave is not sent",
      "run": "@std/object.port.json#make",
      "in": {
        "value": "{{in}}",
        "type": "@customers/domain/CustomerRecord.shape.json"
      }
    },
    {
      "type": "@wilanis/node/switch.schema.json",
      "id": "outcome",
      "label": "What did the API say?",
      "in": {
        "status": "{{posted.status}}",
        "body": "{{posted.body}}"
      },
      "rules": [
        {
          "when": "status == 201 && has(body)",
          "to": "customer"
        }
      ],
      "else": "upstreamFailed"
    },
    {
      "type": "@wilanis/node/run.schema.json",
      "id": "customer",
      "label": "The created row",
      "run": "@std/object.port.json#make",
      "in": {
        "value": "{{posted.body}}",
        "type": "@customers/domain/Customer.shape.json"
      }
    },
    {
      "type": "@wilanis/node/run.schema.json",
      "id": "upstreamFailed",
      "label": "Unexpected answer",
      "run": "@std/outcome.port.json#refuse",
      "in": {
        "reason": "upstream",
        "message": "the customer API answered {{posted.status}}",
        "type": "@customers/domain/Customer.shape.json"
      }
    }
  ]
}
