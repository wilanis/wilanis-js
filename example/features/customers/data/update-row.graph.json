{
  "$schema": "https://raw.githubusercontent.com/wilanis/wilanis-js/main/packages/core/schemas/graph.schema.json",
  "label": "Put a row",
  "description": "Data graph behind customer.keep: PUT the whole customer under their id. 200 is the row as kept, 404 is the declared refusal for an id that does not exist, anything else is a failure. The id is the route's, so the body carries every other field of the customer.",
  "in": "@customers/domain/Customer.shape.json",
  "out": {
    "type": "@customers/domain/Customer.shape.json",
    "from": [
      "customer",
      "noCustomer",
      "upstreamFailed"
    ]
  },
  "nodes": [
    {
      "type": "@wilanis/node/run.schema.json",
      "id": "updated",
      "label": "PUT the customer",
      "run": "@http/http.port.json#request",
      "in": {
        "body": {
          "name": "{{in.name}}",
          "email": "{{in.email}}",
          "tier": "{{in.tier}}",
          "registrar": "{{in.registrar}}",
          "active": "{{in.active}}",
          "note": "{{in.note}}"
        },
        "connection": "@connections/customers-api.connection.json",
        "method": "PUT",
        "path": "/customer/{{in.id}}",
        "consumes": "application/json",
        "produces": "application/json",
        "returns": "@customers/edge/CustomerRow.shape.json"
      }
    },
    {
      "type": "@wilanis/node/switch.schema.json",
      "id": "outcome",
      "label": "What did the API say?",
      "in": {
        "status": "{{updated.status}}",
        "body": "{{updated.body}}"
      },
      "rules": [
        {
          "when": "status == 404",
          "to": "noCustomer"
        },
        {
          "when": "status == 200 && has(body)",
          "to": "customer"
        }
      ],
      "else": "upstreamFailed"
    },
    {
      "type": "@wilanis/node/run.schema.json",
      "id": "customer",
      "label": "The updated row",
      "run": "@std/object.port.json#make",
      "in": {
        "value": "{{updated.body}}",
        "type": "@customers/edge/CustomerRow.shape.json"
      }
    },
    {
      "type": "@wilanis/node/run.schema.json",
      "id": "noCustomer",
      "label": "No such customer",
      "run": "@std/outcome.port.json#refuse",
      "in": {
        "reason": "missing",
        "message": "no customer {{in.id}}",
        "type": "@customers/domain/Customer.shape.json"
      }
    },
    {
      "type": "@wilanis/node/run.schema.json",
      "id": "upstreamFailed",
      "label": "Unexpected answer",
      "run": "@std/outcome.port.json#refuse",
      "in": {
        "reason": "upstream",
        "message": "the customer API answered {{updated.status}}",
        "type": "@customers/domain/Customer.shape.json"
      }
    }
  ]
}
