{
  "$schema": "https://raw.githubusercontent.com/wilanis/wilanis-js/main/packages/core/schemas/graph.schema.json",
  "label": "Update a row",
  "description": "Data graph behind customer.update: PUT the new call. 200 is the updated customer, 404 is the declared refusal for an id that does not exist, anything else is a failure.",
  "in": "@customers/domain/CustomerUpdate.shape.json",
  "out": {
    "type": "@customers/domain/Customer.shape.json",
    "from": [
      "customer",
      "noCustomer",
      "upstreamFailed"
    ]
  },
  "nodes": [
    {
      "type": "@wilanis/node/run.schema.json",
      "id": "updated",
      "label": "PUT the row",
      "run": "@http/http.port.json#request",
      "in": {
        "body": {
          "name": "{{in.name}}",
          "email": "{{in.email}}",
          "tier": "{{in.tier}}"
        },
        "connection": "@connections/customers-api.connection.json",
        "method": "PUT",
        "path": "/customer/{{in.id}}",
        "consumes": "application/json",
        "produces": "application/json",
        "returns": "@customers/edge/CustomerRow.shape.json"
      }
    },
    {
      "type": "@wilanis/node/switch.schema.json",
      "id": "outcome",
      "label": "What did the API say?",
      "in": {
        "status": "{{updated.status}}",
        "body": "{{updated.body}}"
      },
      "rules": [
        {
          "when": "status == 404",
          "to": "noCustomer"
        },
        {
          "when": "status == 200 && has(body)",
          "to": "customer"
        }
      ],
      "else": "upstreamFailed"
    },
    {
      "type": "@wilanis/node/run.schema.json",
      "id": "customer",
      "label": "The updated row",
      "run": "@std/object.port.json#make",
      "in": {
        "value": "{{updated.body}}",
        "type": "@customers/edge/CustomerRow.shape.json"
      }
    },
    {
      "type": "@wilanis/node/run.schema.json",
      "id": "noCustomer",
      "label": "No such customer",
      "run": "@std/outcome.port.json#refuse",
      "in": {
        "reason": "missing",
        "message": "no customer {{in.id}}",
        "type": "@customers/domain/Customer.shape.json"
      }
    },
    {
      "type": "@wilanis/node/run.schema.json",
      "id": "upstreamFailed",
      "label": "Unexpected answer",
      "run": "@std/outcome.port.json#refuse",
      "in": {
        "reason": "upstream",
        "message": "the customer API answered {{updated.status}}",
        "type": "@customers/domain/Customer.shape.json"
      }
    }
  ]
}
