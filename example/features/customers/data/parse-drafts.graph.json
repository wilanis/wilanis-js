{
  "$schema": "https://raw.githubusercontent.com/wilanis/wilanis-js/main/packages/core/schemas/graph.schema.json",
  "label": "Parse drafts",
  "description": "Data graph behind customer.parseDrafts: the uploaded CSV, streamed out of the blob registry and read as customer drafts. The file never enters the graph; its handle does.",
  "in": "blob",
  "out": {
    "type": "@customers/domain/CustomerDraft.shape.json[]",
    "from": "drafts"
  },
  "nodes": [
    {
      "type": "@wilanis/node/run.schema.json",
      "id": "drafts",
      "label": "Read the rows",
      "run": "@blob/csv.port.json#parse",
      "in": {
        "file": "{{in}}",
        "type": "@customers/domain/CustomerDraft.shape.json"
      }
    }
  ]
}
