{
  "$schema": "https://raw.githubusercontent.com/wilanis/wilanis-js/main/packages/core/schemas/graph.schema.json",
  "label": "Get what is kept",
  "description": "Data graph behind customer.get under the local profile: one record by its key. Absence is answered as `record` absent rather than as a failure, so the switch routes on it and the refusal is a case this graph named. The same graph as @customers/data/kept-get.graph.json, against the store kept in PostgreSQL: a store is named statically at a call site, so pointing these at another connection is a copy until a profile may swap one.",
  "in": "@customers/domain/CustomerRef.shape.json",
  "out": {
    "type": "@customers/domain/Customer.shape.json",
    "from": [
      "row",
      "missing"
    ]
  },
  "nodes": [
    {
      "type": "@wilanis/node/run.schema.json",
      "id": "asked",
      "label": "Read the record",
      "run": "@storage/store.port.json#get",
      "in": {
        "store": "@customers/data/customers-postgres.store.json",
        "collection": "customers",
        "key": "{{in.id}}"
      }
    },
    {
      "type": "@wilanis/node/switch.schema.json",
      "id": "route",
      "label": "Is it kept?",
      "in": {
        "record": "{{asked.record}}"
      },
      "rules": [
        {
          "when": "has(record)",
          "to": "row"
        }
      ],
      "else": "missing"
    },
    {
      "type": "@wilanis/node/run.schema.json",
      "id": "row",
      "label": "The record",
      "run": "@std/object.port.json#make",
      "in": {
        "value": "{{asked.record}}",
        "type": "@customers/domain/Customer.shape.json"
      }
    },
    {
      "type": "@wilanis/node/run.schema.json",
      "id": "missing",
      "label": "No such customer",
      "run": "@std/outcome.port.json#refuse",
      "in": {
        "reason": "missing",
        "message": "no customer {{in.id}}",
        "type": "@customers/domain/Customer.shape.json"
      }
    }
  ]
}
