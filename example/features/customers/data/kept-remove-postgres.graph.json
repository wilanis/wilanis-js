{
  "$schema": "https://raw.githubusercontent.com/wilanis/wilanis-js/main/packages/core/schemas/graph.schema.json",
  "label": "Remove what is kept",
  "description": "Data graph behind customer.remove under the local profile: remove the record and answer the one that was removed, so the caller sees what it lost. The same graph as @customers/data/kept-remove.graph.json, against the store kept in PostgreSQL: a store is named statically at a call site, so pointing these at another connection is a copy until a profile may swap one.",
  "in": "@customers/domain/CustomerRef.shape.json",
  "out": {
    "type": "@customers/domain/Customer.shape.json",
    "from": [
      "customer",
      "noCustomer"
    ]
  },
  "nodes": [
    {
      "type": "@wilanis/node/run.schema.json",
      "id": "gone",
      "label": "Remove the record",
      "run": "@storage/store.port.json#remove",
      "in": {
        "store": "@customers/data/customers-postgres.store.json",
        "collection": "customers",
        "key": "{{in.id}}"
      }
    },
    {
      "type": "@wilanis/node/switch.schema.json",
      "id": "wasThere",
      "label": "Was it there?",
      "in": {
        "record": "{{gone.record}}"
      },
      "rules": [
        {
          "when": "has(record)",
          "to": "customer"
        }
      ],
      "else": "noCustomer"
    },
    {
      "type": "@wilanis/node/run.schema.json",
      "id": "customer",
      "label": "The record",
      "run": "@std/object.port.json#make",
      "in": {
        "value": "{{gone.record}}",
        "type": "@customers/domain/Customer.shape.json"
      }
    },
    {
      "type": "@wilanis/node/run.schema.json",
      "id": "noCustomer",
      "label": "No such customer",
      "run": "@std/outcome.port.json#refuse",
      "in": {
        "reason": "missing",
        "message": "no customer {{in.id}}",
        "type": "@customers/domain/Customer.shape.json"
      }
    }
  ]
}
