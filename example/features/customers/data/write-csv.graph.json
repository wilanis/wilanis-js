{
  "$schema": "https://raw.githubusercontent.com/wilanis/wilanis-js/main/packages/core/schemas/graph.schema.json",
  "label": "Write CSV",
  "description": "Data graph behind customer.toCsv: the customers written as customers.csv into the blob registry; the graph answers the handle, and the route streams the file.",
  "in": "@customers/domain/Customer.shape.json[]",
  "out": {
    "type": "blob",
    "from": "file"
  },
  "nodes": [
    {
      "type": "@wilanis/node/run.schema.json",
      "id": "file",
      "label": "Write the file",
      "run": "@blob/csv.port.json#write",
      "in": {
        "rows": "{{in}}",
        "type": "@customers/domain/Customer.shape.json",
        "filename": "customers.csv"
      }
    }
  ]
}
