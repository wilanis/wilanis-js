{
  "name": "@wilanis/runtime",
  "version": "0.1.0",
  "description": "The wilanis runtime and `wilanis` command line: embedder, gates (rehearse, fuzz, regress), discovery, start, plugin packages, with the @std and @cli plugins built in.",
  "type": "module",
  "license": "Apache-2.0",
  "author": "Rafael Fontes <rfontes1987@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wilanis/wilanis-js.git",
    "directory": "packages/runtime"
  },
  "homepage": "https://github.com/wilanis/wilanis-js/tree/main/packages/runtime#readme",
  "bugs": "https://github.com/wilanis/wilanis-js/issues",
  "keywords": [
    "wilanis",
    "dataflow",
    "json-schema",
    "declarative",
    "runtime",
    "cli"
  ],
  "bin": {
    "wilanis": "./bin/wilanis.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "docs",
    "bin",
    "templates",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "@wilanis/compiler": "0.1.0",
    "@wilanis/core": "0.1.0",
    "@wilanis/engine": "0.1.0"
  },
  "devDependencies": {
    "@wilanis/plugin-http": "0.1.0",
    "@wilanis/plugin-blob": "0.1.0",
    "@wilanis/plugin-reload": "0.1.0",
    "@wilanis/plugin-auth": "0.1.0",
    "@wilanis/plugin-storage": "0.1.0",
    "@wilanis/plugin-storage-memory": "0.1.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  }
}
