    "directory": "packages/plugin-s3"
  },
  "homepage": "https://github.com/wilanis/wilanis-js/tree/main/packages/plugin-s3#readme",
  "bugs": "https://github.com/wilanis/wilanis-js/issues",
  "keywords": [
    "wilanis",
    "dataflow",
    "json-schema",
    "declarative",
    "s3",
