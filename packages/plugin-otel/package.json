{
  "name": "@wilanis/plugin-otel",
  "version": "0.1.0",
  "description": "The @otel plugin for wilanis: ship every run of a tree to an OpenTelemetry collector as spans, in the tree's own words.",
  "type": "module",
  "license": "Apache-2.0",
  "author": "Rafael Fontes <rfontes1987@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wilanis/wilanis-js.git",
    "directory": "packages/plugin-otel"
  },
  "homepage": "https://github.com/wilanis/wilanis-js/tree/main/packages/plugin-otel#readme",
  "bugs": "https://github.com/wilanis/wilanis-js/issues",
  "keywords": [
    "wilanis",
    "dataflow",
    "json-schema",
    "declarative",
    "opentelemetry",
    "otlp",
    "tracing",
    "observability",
    "plugin"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@wilanis/core": "0.1.0",
    "@wilanis/engine": "0.1.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@wilanis/compiler": "0.1.0",
    "@wilanis/runtime": "0.1.0"
  }
}
