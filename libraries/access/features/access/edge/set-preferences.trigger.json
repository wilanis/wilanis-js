{
  "$schema": "https://raw.githubusercontent.com/wilanis/wilanis-js/main/packages/core/schemas/trigger.schema.json",
  "label": "PUT /api/v1/me/preferences",
  "description": "Keep a theme in the caller's session and answer the preferences whole. A later GET, with the same token or a refreshed one, reads it back. Gated by signed-in, the token read from the Authorization header or the session cookie.",
  "settings": {
    "route": "/api/v1/me/preferences",
    "method": "PUT",
    "produces": "application/json",
    "consumes": "application/json",
    "body": "@access/edge/PreferencesUpdate.shape.json",
    "response": {
      "refusals": {
        "anonymous": 401,
        "invalid_credential": 401
      }
    }
  },
  "in": "@access/edge/PreferencesUpdate.shape.json",
  "out": "@access/edge/PreferencesView.shape.json",
  "policies": [
    {
      "policy": "@access/edge/signed-in.policy.json",
      "in": {
        "token": [
          "{{context.headers.authorization}}",
          "{{context.cookies.session}}"
        ]
      }
    }
  ],
  "kind": "@http/http.trigger-kind.json",
  "fire": {
    "run": "@access/domain/access.port.json#savePreferences",
    "in": {
      "theme": "{{context.body.theme}}"
    }
  }
}
