{
  "$schema": "https://raw.githubusercontent.com/wilanis/wilanis-js/main/packages/core/schemas/trigger.schema.json",
  "label": "GET /api/v1/me/preferences",
  "description": "The caller's preferences, read from the session the token names. Gated by signed-in, the token read from the Authorization header or the session cookie.",
  "settings": {
    "route": "/api/v1/me/preferences",
    "method": "GET",
    "produces": "application/json",
    "response": {
      "refusals": {
        "anonymous": 401,
        "invalid_credential": 401
      }
    }
  },
  "out": "@access/edge/PreferencesView.shape.json",
  "policies": [
    {
      "policy": "@access/edge/signed-in.policy.json",
      "in": {
        "token": [
          "{{context.headers.authorization}}",
          "{{context.cookies.session}}"
        ]
      }
    }
  ],
  "kind": "@http/http.trigger-kind.json",
  "fire": {
    "run": "@access/domain/access.port.json#preferences"
  }
}
