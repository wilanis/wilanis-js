{
  "$schema": "https://raw.githubusercontent.com/wilanis/wilanis-js/main/packages/core/schemas/policy.schema.json",
  "label": "Can register",
  "description": "A caller holding the registrar role: the directory's group, written into the token at sign-in.",
  "decide": {
    "run": "@access/domain/access.port.json#requireRegistrar",
    "in": {
      "principal": "{{context.principal}}"
    }
  },
  "proves": [
    "context.principal",
    "context.session"
  ],
  "outcomes": {
    "anonymous": {
      "effect": "deny"
    },
    "forbidden": {
      "effect": "deny",
      "description": "signed in, but without the registrar role"
    }
  }
}
