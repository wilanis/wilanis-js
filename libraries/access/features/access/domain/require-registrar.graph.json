{
  "$schema": "https://raw.githubusercontent.com/wilanis/wilanis-js/main/packages/core/schemas/graph.schema.json",
  "label": "Require the registrar role",
  "description": "A token carrying the registrar role is allowed; any other is forbidden; none is anonymous.",
  "in": "@access/domain/PrincipalGate.shape.json",
  "out": {
    "type": "@access/domain/Grant.shape.json",
    "from": [
      "granted",
      "forbidden",
      "anonymous"
    ]
  },
  "nodes": [
    {
      "type": "@wilanis/node/switch.schema.json",
      "id": "decide",
      "label": "What may they do?",
      "in": {
        "principal": "{{in.principal}}"
      },
      "rules": [
        {
          "when": "has(principal) && 'registrar' in principal.roles",
          "to": "granted"
        },
        {
          "when": "has(principal)",
          "to": "forbidden"
        }
      ],
      "else": "anonymous"
    },
    {
      "type": "@wilanis/node/run.schema.json",
      "id": "granted",
      "label": "Allowed",
      "run": "@std/object.port.json#make",
      "in": {
        "value": {
          "allowed": true
        },
        "type": "@access/domain/Grant.shape.json"
      }
    },
    {
      "type": "@wilanis/node/run.schema.json",
      "id": "forbidden",
      "label": "No registrar role",
      "run": "@std/outcome.port.json#refuse",
      "in": {
        "reason": "forbidden",
        "message": "registering customers takes the registrar role",
        "type": "@access/domain/Grant.shape.json"
      }
    },
    {
      "type": "@wilanis/node/run.schema.json",
      "id": "anonymous",
      "label": "No caller",
      "run": "@std/outcome.port.json#refuse",
      "in": {
        "reason": "anonymous",
        "message": "sign in first: no token was presented",
        "type": "@access/domain/Grant.shape.json"
      }
    }
  ]
}
