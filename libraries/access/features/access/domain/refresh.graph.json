{
  "$schema": "https://raw.githubusercontent.com/wilanis/wilanis-js/main/packages/core/schemas/graph.schema.json",
  "label": "Refresh a token pair",
  "description": "Trade the refresh token; a pair comes back when it was good, and invalid_refresh is refused when it was not.",
  "in": "@access/domain/RefreshToken.shape.json",
  "out": {
    "type": "@access/domain/Tokens.shape.json",
    "from": [
      "renewed",
      "invalid"
    ]
  },
  "nodes": [
    {
      "type": "@wilanis/node/run.schema.json",
      "id": "traded",
      "label": "Trade the refresh token",
      "run": "@access/domain/identity.port.json#refresh",
      "in": {
        "refreshToken": "{{in.refreshToken}}"
      }
    },
    {
      "type": "@wilanis/node/switch.schema.json",
      "id": "wasGood",
      "label": "Was it good?",
      "in": {
        "refreshed": "{{traded.refreshed}}",
        "tokens": "{{traded.tokens}}"
      },
      "rules": [
        {
          "when": "refreshed == true && has(tokens)",
          "to": "renewed"
        }
      ],
      "else": "invalid"
    },
    {
      "type": "@wilanis/node/run.schema.json",
      "id": "renewed",
      "label": "The new pair",
      "run": "@std/object.port.json#make",
      "in": {
        "value": "{{traded.tokens}}",
        "type": "@access/domain/Tokens.shape.json"
      }
    },
    {
      "type": "@wilanis/node/run.schema.json",
      "id": "invalid",
      "label": "Not a live refresh token",
      "run": "@std/outcome.port.json#refuse",
      "in": {
        "reason": "invalid_refresh",
        "message": "the refresh token is unknown, spent or expired",
        "type": "@access/domain/Tokens.shape.json"
      }
    }
  ]
}
